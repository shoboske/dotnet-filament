<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <!-- `dotnet pack src/Fila.Tools -o artifacts/nuget-local` populates this before
         `dotnet tool restore` can install the fila local tool from it. -->
    <add key="fila-local" value="artifacts/nuget-local" />
  </packageSources>
</configuration>
