<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>Fila.Tools</RootNamespace>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>fila</ToolCommandName>
    <PackageId>Fila.Tools</PackageId>
    <Description>dotnet fila — dispatches to the fila CLI commands (make:panel, make:resource) inside a target ASP.NET Core project, the way `dotnet ef` dispatches into a project's EF Core tooling.</Description>
  </PropertyGroup>

</Project>
