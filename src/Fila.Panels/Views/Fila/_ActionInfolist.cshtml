@model FilaActionInfolistViewModel
@inject ComponentViewRegistry Registry
@{
    Layout = null;
    var evaluation = Model.Evaluation;
}
@* ViewAction has no confirmation step, so CanOpenModal::getModalWidth() falls through to its
   non-confirmation default, Width::FourExtraLarge -- the same wide modal Create/Edit forms get
   in _ActionForm.cshtml, confirmed against a live rendered View modal's own
   fi-modal-window-has-content fi-width-4xl classes. Only a confirmation action (_ActionConfirm,
   _BulkActionConfirm) gets Width::Medium instead. *@
<div class="fi-modal-header" x-init="$el.closest('.fi-modal-window')?.classList.add('fi-modal-window-wide')">
    <h2 class="fi-modal-heading">@Model.Action.ResolveModalHeading(evaluation)</h2>
    <button type="button" class="fi-modal-close-btn" @@click="modalOpen = false" aria-label="Close">
        @Html.Raw(IconRegistry.Render("x"))
    </button>
</div>

<div class="fi-modal-content">
    @* Same page-level ->columns(2) default _ActionForm.cshtml's comment explains -- an
       infolist schema gets it too (confirmed live: a View modal's entries sit in a real
       fi-grid lg:fi-grid-cols, not the single stacked column this used to render). *@
    <div class="fi-grid lg:fi-grid-cols fi-sc fi-sc-has-gap"
         style="--cols-default: repeat(1, minmax(0, 1fr)); --cols-lg: repeat(2, minmax(0, 1fr))">
        @foreach (var entry in Model.Infolist.Entries.Where(e => e.ResolveVisible(evaluation)))
        {
            <div class="fi-grid-col" style="--col-span-default: span 1 / span 1">
                <div class="fi-sc-component">
                    <div class="fi-in-entry">
                        <div class="fi-in-entry-label-col">
                            <div class="fi-in-entry-label-ctn">
                                <div class="fi-in-entry-label" role="term">@entry.ResolveLabel(evaluation)</div>
                            </div>
                        </div>
                        <div class="fi-in-entry-content-col">
                            <div class="fi-in-entry-content-ctn" role="definition">
                                <div class="fi-in-entry-content">
                                    <partial name="@Registry.PartialForEntry(entry.View)" model="new EntryRenderModel(entry, Model.Entity)" />
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</div>

<div class="fi-modal-footer">
    <div class="fi-modal-footer-actions">
        <button type="button" class="fi-btn fi-btn-outlined" @@click="modalOpen = false">Close</button>
    </div>
</div>
