@model FilaListViewModel
@{
    ViewBag.Title = Model.Panel.Brand;
    ViewBag.PanelForLayout = Model.Panel;
    var resourceUrl = $"/{Model.Panel.Path}/{Model.Resource.Slug}";
    var resourceLabel = Model.Panel.Navigation.FirstOrDefault(n => n.Slug == Model.Resource.Slug)?.Label ?? Model.Resource.Slug;
}
<div x-data="filaTable" class="fi-shell" data-fila-endpoint="/@Model.Panel.Path/@Model.Resource.Slug">

    <partial name="Fila/_Sidebar" model="new FilaSidebarModel(Model.Panel, Model.Resource.Slug)" />

    <div class="fi-main">
        <div class="fi-page-header-ctn">
            <nav class="fi-breadcrumbs" aria-label="Breadcrumb">
                <ol>
                    <li><a href="@resourceUrl">@resourceLabel</a></li>
                    <li>
                        @Html.Raw(IconRegistry.Render("chevron-right"))
                        <span>List</span>
                    </li>
                </ol>
            </nav>
            <header class="fi-header">
                <h1 class="fi-header-heading">@resourceLabel</h1>
                @{ var createAction = Model.Resource.BuildCreateAction(); }
                @if (createAction is not null)
                {
                    <div class="fi-header-actions-ctn">
                        <button type="button" class="fi-btn fi-btn-primary"
                                hx-get="@resourceUrl/actions/create"
                                hx-target="#fila-modal-body" hx-swap="innerHTML"
                                hx-include="#fila-table-state">
                            @Html.Raw(IconRegistry.Render(createAction.IconName))
                            @createAction.ResolveLabel(Model.Evaluation)
                        </button>
                    </div>
                }
            </header>
        </div>

        <div class="fi-ta-card">
            <div id="fila-loading" class="fi-ta-loading htmx-indicator" aria-live="polite">Loading…</div>

            <div id="fila-table">
                <partial name="Fila/_Table" model="Model" />
            </div>
        </div>
    </div>

    <div class="fi-modal" x-show="modalOpen" x-cloak
         @@fila-modal-open.window="modalOpen = true" @@fila-modal-close.window="modalOpen = false"
         @@keydown.escape.window="modalOpen = false">
        <div class="fi-modal-close-overlay" @@click="modalOpen = false"></div>
        <div class="fi-modal-window-ctn">
            <div class="fi-modal-window" id="fila-modal-body" @@click.stop>
                <!-- htmx swaps Fila/_Form content in here -->
            </div>
        </div>
    </div>
</div>
