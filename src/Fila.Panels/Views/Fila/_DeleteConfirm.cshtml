@model FilaDeleteConfirmViewModel
@{
    Layout = null;
    var deleteUrl = $"/{Model.Panel.Path}/{Model.Resource.Slug}/{Model.Id}/delete";
}
<div class="fi-modal-header fi-align-center">
    <div class="fi-modal-icon-ctn">
        <span class="fi-modal-icon-bg">
            @Html.Raw(IconRegistry.Render("trash"))
        </span>
    </div>
    <h2 class="fi-modal-heading">Delete @Model.Label</h2>
    <p class="fi-modal-description">Are you sure you would like to do this?</p>
</div>

<div class="fi-modal-footer">
    <div class="fi-modal-footer-actions fi-align-center">
        <button type="button" class="fi-btn fi-btn-danger"
                hx-post="@deleteUrl" hx-target="#fila-table" hx-swap="innerHTML"
                hx-include="#fila-table-state">
            Delete
        </button>
        <button type="button" class="fi-btn fi-btn-outlined" @@click="modalOpen = false">Cancel</button>
    </div>
</div>
