@model WidgetRenderModel
@using System.Text.Json
@using Fila.Widgets
@{
    Layout = null;
    var chart = (ChartData)Model.Data;
    var points = chart.Points;
}
@* Structure mirrors packages/widgets/resources/views/chart-widget.blade.php: the widget wraps a
   <x-filament::section>, whose content holds .fi-wi-chart-frame — a <canvas> painted by
   Chart.js (vendored locally, see wwwroot/fila/vendor), same as upstream. *@
<div class="fi-wi-chart">
    <div class="fi-section@(Model.Widget.Heading is not null ? " fi-section-has-header" : "")">
        <partial name="Fila/Widgets/_Section" model="Model.Widget" />

        <div class="fi-section-content-ctn">
        <div class="fi-section-content">
    @if (points.Count == 0)
    {
        @* Filament renders <x-filament::empty-state :contained="false"> inside the frame here. *@
        <div class="fi-wi-chart-frame">
            <div class="fi-ta-empty-state">
                <div class="fi-ta-empty-state-content">
                    <span class="fi-ta-empty-state-icon-bg">@Html.Raw(IconRegistry.Render("inbox"))</span>
                    <h3 class="fi-ta-empty-state-heading">No chart data</h3>
                </div>
            </div>
        </div>
    }
    else
    {
        // Fed to fila.charts.js as JSON via a data attribute — Razor HTML-encodes the
        // interpolated string by default (unlike Html.Raw), so embedded quotes come out
        // &quot;-escaped and the browser hands JSON.parse() the original text back.
        var payload = JsonSerializer.Serialize(new
        {
            labels = points.Select(p => p.Label),
            values = points.Select(p => p.Value),
            datasetLabel = Model.Widget.Heading ?? "Chart",
            valuePrefix = chart.ValuePrefix ?? "",
            valueSuffix = chart.ValueSuffix ?? "",
        });

        <div class="fi-wi-chart-frame" data-fila-chart="@payload">
            <canvas class="fi-wi-chart-canvas" role="img" aria-label="@(Model.Widget.Heading ?? "Chart")"></canvas>
            @* Filament hands Chart.js four colours by reading computed styles off elements
               carrying these classes rather than duplicating the palette in JS — see
               fila.charts.js and fila.widgets.css's .fi-wi-chart-{bg,border,grid,text}-color. *@
            <span class="fi-wi-chart-bg-color"></span>
            <span class="fi-wi-chart-border-color"></span>
            <span class="fi-wi-chart-grid-color"></span>
            <span class="fi-wi-chart-text-color"></span>
        </div>
    }
        </div>
        </div>
    </div>
</div>
