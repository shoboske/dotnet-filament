@model WidgetRenderModel
@using System.Globalization
@using Microsoft.AspNetCore.Html
@using Fila.Widgets
@{
    Layout = null;
    var chart = (ChartData)Model.Data;
    var points = chart.Points;

    // 3:2, matching the aspect-[1.5] that packages/widgets/resources/css/chart-widget.css gives
    // .fi-wi-chart-frame at container width — the frame's CSS sets the box, this viewBox fills
    // it exactly rather than letterboxing inside it. A fixed viewBox scaled by CSS also means
    // the chart stays crisp at any size with no measurement, resize observer or script.
    const double Width = 600, Height = 400;
    const double PadLeft = 52, PadRight = 12, PadTop = 12, PadBottom = 32;
    const double PlotW = Width - PadLeft - PadRight;
    const double PlotH = Height - PadTop - PadBottom;

    // Same display culture TextColumn formats money and dates with, so a chart's numbers read
    // the same as the table's.
    var display = CultureInfo.GetCultureInfo("en-US");

    // Baseline pinned to zero whenever the series is entirely positive. A line chart that crops
    // its own baseline turns every small wiggle into a cliff — the classic misleading chart.
    var lo = points.Count == 0 ? 0m : Math.Min(0m, points.Min(p => p.Value));
    var hi = points.Count == 0 ? 1m : points.Max(p => p.Value);
    if (hi <= lo) hi = lo + 1m;

    double X(int i) => points.Count == 1
        ? PadLeft + PlotW / 2
        : PadLeft + i * PlotW / (points.Count - 1);

    double Y(decimal value) => PadTop + (1 - (double)((value - lo) / (hi - lo))) * PlotH;

    // Invariant, always: SVG path data is not localised, and a server running under a culture
    // with a comma decimal separator would otherwise emit "12,5" and silently break every path.
    string N(double v) => v.ToString("0.##", CultureInfo.InvariantCulture);

    // Razor treats a literal <text> tag as its own construct and refuses to let it carry
    // attributes (RZ1023), so SVG's <text> — which is not optional here — is emitted as raw
    // HTML instead. Html.Encode keeps a label that contains markup characters safe.
    IHtmlContent AxisLabel(double x, double y, string anchor, string content) => new HtmlString(
        $"""<text class="fi-wi-chart-text-color" x="{N(x)}" y="{N(y)}" text-anchor="{anchor}">{Html.Encode(content)}</text>""");

    string FormatValue(decimal v) =>
        chart.ValuePrefix
        + (v == Math.Truncate(v) ? v.ToString("N0", display) : v.ToString("N2", display))
        + chart.ValueSuffix;
}
@* Structure mirrors packages/widgets/resources/views/chart-widget.blade.php: the widget wraps a
   <x-filament::section>, whose content holds .fi-wi-chart-frame. Filament puts a <canvas> in
   that frame and paints it with Chart.js; this puts server-rendered SVG in the same box. *@
<div class="fi-wi-chart">
    <div class="fi-section@(Model.Widget.Heading is not null ? " fi-section-has-header" : "")">
        <partial name="Fila/Widgets/_Section" model="Model.Widget" />

        <div class="fi-section-content-ctn">
        <div class="fi-section-content">
    @if (points.Count == 0)
    {
        @* Filament renders <x-filament::empty-state :contained="false"> inside the frame here. *@
        <div class="fi-wi-chart-frame">
            <div class="fi-ta-empty-state">
                <div class="fi-ta-empty-state-content">
                    <span class="fi-ta-empty-state-icon-bg">@Html.Raw(IconRegistry.Render("inbox"))</span>
                    <h3 class="fi-ta-empty-state-heading">No chart data</h3>
                </div>
            </div>
        </div>
    }
    else
    {
        var line = string.Join(" ", points.Select((p, i) => $"{N(X(i))},{N(Y(p.Value))}"));
        var area = $"M {N(X(0))},{N(Y(lo))} "
                 + string.Join(" ", points.Select((p, i) => $"L {N(X(i))},{N(Y(p.Value))}"))
                 + $" L {N(X(points.Count - 1))},{N(Y(lo))} Z";

        // Label every point while they still fit; past that, thin them down to at most six,
        // spaced evenly across the series and always including both ends. Labelling every Nth
        // point *plus* the last one is what crowds the axis — with 14 points and a stride of 3
        // the final two labels land side by side and overlap.
        var labelCount = Math.Min(points.Count, 6);
        var labelled = Enumerable.Range(0, labelCount)
            .Select(k => labelCount == 1 ? 0 : (int)Math.Round(k * (points.Count - 1) / (double)(labelCount - 1)))
            .ToHashSet();

        <div class="fi-wi-chart-frame">
            <svg viewBox="0 0 @N(Width) @N(Height)" class="fi-wi-chart-svg" role="img"
                 aria-label="@(Model.Widget.Heading ?? "Chart"): @FormatValue(points[0].Value) on @points[0].Label to @FormatValue(points[^1].Value) on @points[^1].Label">

                @foreach (var value in new[] { hi, lo + (hi - lo) / 2, lo })
                {
                    <line class="fi-wi-chart-grid-color" x1="@N(PadLeft)" y1="@N(Y(value))" x2="@N(PadLeft + PlotW)" y2="@N(Y(value))" />
                    @AxisLabel(PadLeft - 8, Y(value) + 4, "end", FormatValue(value))
                }

                <path class="fi-wi-chart-bg-color" d="@area" />
                <polyline class="fi-wi-chart-border-color" points="@line" />

                @for (var i = 0; i < points.Count; i++)
                {
                    <circle class="fi-wi-chart-dot fi-wi-chart-border-color" cx="@N(X(i))" cy="@N(Y(points[i].Value))" r="3">
                        @* A native SVG tooltip — hover detail with no script and no library. *@
                        <title>@points[i].Label: @FormatValue(points[i].Value)</title>
                    </circle>

                    if (labelled.Contains(i))
                    {
                        // The outermost labels anchor inward. Centred on their own point they
                        // would hang past the viewBox and be clipped, since the first and last
                        // points sit on the plot's edges.
                        var anchor = i == 0 ? "start" : i == points.Count - 1 ? "end" : "middle";
                        @AxisLabel(X(i), Height - 8, anchor, points[i].Label)
                    }
                }
            </svg>
        </div>
    }
        </div>
        </div>
    </div>
</div>
