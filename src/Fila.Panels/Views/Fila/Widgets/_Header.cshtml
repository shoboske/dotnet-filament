@model Fila.Widgets.Widget
@{
    Layout = null;
}
@* One heading block, included by whichever widget partial wants one and placed wherever that
   partial wants it — inside the card for a table or chart, above the row for a stats overview.
   Renders nothing at all when the widget declares no heading. *@
@if (Model.Heading is { } heading)
{
    <div class="fi-wi-header">
        <h2 class="fi-wi-heading">@heading</h2>
        @if (Model.Description is { } description)
        {
            <p class="fi-wi-description">@description</p>
        }
    </div>
}
