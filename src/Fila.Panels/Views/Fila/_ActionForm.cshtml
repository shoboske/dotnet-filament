@model FilaActionFormViewModel
@inject ComponentViewRegistry Registry
@{
    Layout = null;
    var evaluation = Model.Evaluation;
    var readOnly = Model.Action.ReadOnlyFlag;
    // A header action's record doesn't exist until Handle runs — Model.Id is null exactly when
    // Model.Entity is a freshly Resource.CreateBlank()'d instance, every property still at its
    // CLR default. See FieldBinding.IsUnsetClrDefault for why that matters here.
    var isCreate = Model.Id is null;
}
<div class="fi-modal-header" x-init="$el.closest('.fi-modal-window')?.classList.add('fi-modal-window-wide')">
    <h2 class="fi-modal-heading">@Model.Action.ResolveModalHeading(evaluation)</h2>
    <button type="button" class="fi-modal-close-btn" @@click="modalOpen = false" aria-label="Close">
        @Html.Raw(IconRegistry.Render("x"))
    </button>
</div>

<form hx-post="@Model.ActionUrl" hx-target="#fila-table" hx-swap="innerHTML" hx-include="#fila-table-state">
    <div class="fi-modal-content">
        @* Every Create/Edit action form gets a 2-column grid unless the resource opted out —
           Filament's ListRecords/EditRecord wrap the resource's own form schema with
           ->columns(2) for exactly the Create/Edit actions, the same page-level default this
           reproduces (packages/filament/src/Resources/Pages/{ListRecords,EditRecord}.php).
           Fila has no per-form column override yet, so this is unconditional for now. *@
        <div class="fi-grid lg:fi-grid-cols fi-sc fi-sc-has-gap"
             style="--cols-default: repeat(1, minmax(0, 1fr)); --cols-lg: repeat(2, minmax(0, 1fr))">
            @foreach (var field in Model.Form.Fields.Where(f => f.ResolveVisible(evaluation)))
            {
                var label = field.ResolveLabel(evaluation);
                var value = field.GetValue(Model.Entity);
                if (isCreate && FieldBinding.IsUnsetClrDefault(value)) value = null;
                var rawValue = FieldBinding.Format(value);
                var error = Model.ErrorFor(field.Path);
                var fieldId = $"fila-field-{field.Path}";

                <div class="fi-grid-col" style="--col-span-default: span 1 / span 1">
                    <div class="fi-sc-component fi-field">
                        @if (field.View != "checkbox")
                        {
                            <label class="fi-login-label" for="@fieldId">
                                @label
                                @if (field.ResolveRequired(evaluation))
                                {
                                    <sup class="fi-required-mark">*</sup>
                                }
                            </label>
                        }

                        <partial name="@Registry.PartialForField(field.View)" model="new FieldRenderModel(field, evaluation, fieldId, rawValue, readOnly)" />

                        @if (error is not null)
                        {
                            <p class="fi-login-error">@error</p>
                        }
                    </div>
                </div>
            }
        </div>
    </div>

    <div class="fi-modal-footer">
        <div class="fi-modal-footer-actions">
            @if (!readOnly)
            {
                <button type="submit" class="fi-btn fi-btn-primary">@Model.Action.ResolveModalSubmitActionLabel(evaluation)</button>
            }
            @if (!readOnly && Model.Action.SupportsCreateAnotherFlag)
            {
                @* Filament's own submit-button-name trick (makeModalSubmitAction('createAnother',
                   arguments: ['another' => true])): the button's own name/value pair rides along
                   with the rest of the form only when THIS button is what triggered the submit —
                   native <form> behaviour htmx's own serializer respects, so no extra JS is
                   needed to tell the two submit paths apart server-side. *@
                <button type="submit" name="another" value="true" class="fi-btn fi-btn-outlined">Create &amp; create another</button>
            }
            <button type="button" class="fi-btn fi-btn-outlined" @@click="modalOpen = false">@(readOnly ? "Close" : "Cancel")</button>
        </div>
    </div>
</form>
