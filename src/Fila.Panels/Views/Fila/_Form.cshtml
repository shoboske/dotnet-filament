@model FilaFormViewModel
@inject ComponentViewRegistry Registry
@{
    Layout = null;
    var evaluation = Model.Evaluation;
    var actionUrl = Model.IsCreate
        ? $"/{Model.Panel.Path}/{Model.Resource.Slug}"
        : $"/{Model.Panel.Path}/{Model.Resource.Slug}/{Model.Id}";
}
<div class="fi-modal-header">
    <h2 class="fi-modal-heading">@(Model.IsCreate ? "Create" : "Edit") @Model.Resource.Slug.TrimEnd('s').Replace('-', ' ')</h2>
    <button type="button" class="fi-modal-close-btn" @@click="modalOpen = false" aria-label="Close">
        @Html.Raw(IconRegistry.Render("x"))
    </button>
</div>

<form hx-post="@actionUrl" hx-target="#fila-table" hx-swap="innerHTML" hx-include="#fila-table-state">
    <div class="fi-modal-content">
        @foreach (var field in Model.Form.Fields.Where(f => f.ResolveVisible(evaluation)))
        {
            var label = field.ResolveLabel(evaluation);
            var rawValue = FieldBinding.Format(field.GetValue(Model.Entity));
            var error = Model.ErrorFor(field.Path);
            var fieldId = $"fila-field-{field.Path}";

            <div class="fi-field">
                @if (field.View != "checkbox")
                {
                    <label class="fi-login-label" for="@fieldId">
                        @label
                        @if (field.ResolveRequired(evaluation))
                        {
                            <sup class="fi-required-mark">*</sup>
                        }
                    </label>
                }

                <partial name="@Registry.PartialForField(field.View)" model="new FieldRenderModel(field, evaluation, fieldId, rawValue)" />

                @if (error is not null)
                {
                    <p class="fi-login-error">@error</p>
                }
            </div>
        }
    </div>

    <div class="fi-modal-footer">
        <div class="fi-modal-footer-actions">
            <button type="submit" class="fi-btn fi-btn-primary">Save</button>
            <button type="button" class="fi-btn fi-btn-outlined" @@click="modalOpen = false">Cancel</button>
        </div>
    </div>
</form>
