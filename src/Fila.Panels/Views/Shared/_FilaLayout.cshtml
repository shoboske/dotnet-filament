<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@(ViewBag.Title ?? "Admin") · Fila</title>
    <partial name="Fila/_ThemeScript" />
    <script src="/_content/Fila/fila/vendor/htmx.min.js" defer></script>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="/_content/Fila/fila/fila.css" />
    @if (ViewBag.PanelForLayout is Fila.Panels.Panel panelForLayout)
    {
        <partial name="Fila/_PrimaryColorOverride" model="panelForLayout" />
    }
</head>
<body class="fi-body">
    @RenderBody()
    <script src="/_content/Fila/fila/vendor/chart.min.js" defer></script>
    <script src="/_content/Fila/fila/fila.charts.js" defer></script>
    <script src="/_content/Fila/fila/fila.js" defer></script>
    <script src="/_content/Fila/fila/vendor/alpine.min.js" defer></script>
</body>
</html>
