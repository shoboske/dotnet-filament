@model FilaListViewModel
@{
    ViewBag.Title = Model.Panel.Brand;
}
<div x-data="filaTable" class="fi-shell" data-fila-endpoint="/@Model.Panel.Path/@Model.Resource.Slug">

    <aside class="fi-sidebar">
        <div class="fi-sidebar-brand">@Model.Panel.Brand</div>
        <nav class="fi-sidebar-nav" aria-label="Resources">
            @foreach (var item in Model.Panel.Navigation)
            {
                var isActive = item.Slug == Model.Resource.Slug;
                <a class="fi-sidebar-link@(isActive ? " fi-sidebar-link-active" : "")"
                   href="/@Model.Panel.Path/@item.Slug"
                   aria-current="@(isActive ? "page" : null)">
                    @Html.Raw(IconRegistry.Render(item.NavigationIcon))
                    <span>@item.Label</span>
                </a>
            }
        </nav>

        @if (Model.Panel.LogoutPath is not null && Context.User.Identity?.IsAuthenticated == true)
        {
            <div class="fi-sidebar-footer">
                <span class="fi-sidebar-user">@Context.User.Identity!.Name</span>
                <form method="post" action="@Model.Panel.LogoutPath">
                    <button type="submit" class="fi-sidebar-logout">Sign out</button>
                </form>
            </div>
        }
    </aside>

    <div class="fi-main">
        <div class="fi-ta-card">
            <div class="fi-ta-toolbar">
                <h2 class="fi-ta-heading">@Model.Resource.Slug.Replace('-', ' ')</h2>

                <input type="search"
                       name="search"
                       value="@Model.Query.Search"
                       placeholder="Search"
                       class="fi-input fi-ta-search"
                       aria-label="Search"
                       hx-get="/@Model.Panel.Path/@Model.Resource.Slug"
                       hx-target="#fila-table"
                       hx-trigger="input changed delay:300ms, search"
                       hx-include="#fila-table-state"
                       hx-push-url="true"
                       hx-indicator="#fila-loading" />
            </div>

            <div id="fila-table-state">
                <input type="hidden" name="sort" value="@Model.Query.Sort" />
                <input type="hidden" name="dir" value="@Model.Query.Dir" />
                <input type="hidden" name="page" value="@Model.Query.Page" />
            </div>

            <div id="fila-loading" class="fi-ta-loading htmx-indicator" aria-live="polite">Loading…</div>

            <div id="fila-table">
                <partial name="Fila/_Table" model="Model" />
            </div>
        </div>
    </div>
</div>
